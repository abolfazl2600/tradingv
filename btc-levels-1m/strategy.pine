//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}

// BTC Levels 1m Bot v1.1 — a NEW, independent strategy.
// The original btc-futures/ strategy is not imported or modified.
// Standard 1-minute candles; all level windows exclude the signal candle.
strategy("BTC Levels 1m | FA | v1.1",
     overlay = true,
     initial_capital = 1000,
     currency = currency.USD,
     pyramiding = 0,
     margin_long = 10,
     margin_short = 10,
     commission_type = strategy.commission.percent,
     commission_value = 0.05,
     slippage = 2,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     max_bars_back = 3500)

// ─────────────────────────────────────────────────────────────────────
// 1. Main entry settings — all inputs in Persian
// ─────────────────────────────────────────────────────────────────────
gEntry = "۱. ورود ۱ دقیقه‌ای"
allowLong = input.bool(true, "اجازه ورود لانگ", group = gEntry)
allowShort = input.bool(true, "اجازه ورود شورت", group = gEntry)
requireLineClose = input.bool(true, "الزام بسته‌شدن قیمت نزدیک یکی از خطوط",
     tooltip = "روشن: کلوز کندل تاییدشده ۱ دقیقه باید در فاصله مجاز از دست‌کم یکی از خطوط فعال باشد. خاموش: با هر کلوز ۱ دقیقه و هم‌جهتی روند روزانه/هفتگی اجازه ورود می‌دهد (با رعایت فاصله بین ورودها).",
     group = gEntry)
tolerancePct = input.float(0.05, "حداکثر فاصله کلوز از خط (%)",
     minval = 0.00, maxval = 2.0, step = 0.01,
     tooltip = "۰٪ به معنی برخورد دقیق کلوز با سطح است؛ برای قیمت‌های پیوسته معمولاً ۰٫۰۵٪ عملی‌تر است.",
     group = gEntry)
entryCooldown = input.int(15, "حداقل فاصله بین ورودها (کندل ۱دقیقه)",
     minval = 0, maxval = 1440, group = gEntry)

// ─────────────────────────────────────────────────────────────────────
// 2. Choose which historical windows can trigger an entry
// ─────────────────────────────────────────────────────────────────────
gPeriods = "۲. خطوط مجاز برای سیگنال"
use3h = input.bool(true, "سیگنال از سقف/کف ۳ ساعت", group = gPeriods)
use6h = input.bool(true, "سیگنال از سقف/کف ۶ ساعت", group = gPeriods)
use9h = input.bool(true, "سیگنال از سقف/کف ۹ ساعت", group = gPeriods)
use12h = input.bool(true, "سیگنال از سقف/کف ۱۲ ساعت", group = gPeriods)
use24h = input.bool(true, "سیگنال از سقف/کف ۲۴ ساعت", group = gPeriods)
use48h = input.bool(true, "سیگنال از سقف/کف ۴۸ ساعت", group = gPeriods)

// ─────────────────────────────────────────────────────────────────────
// 3. Profit/loss and sizing — percentages are BTC PRICE changes
// ─────────────────────────────────────────────────────────────────────
gRisk = "۳. سرمایه و حد سود/ضرر"
capitalPct = input.float(50.0, "درصد موجودی اختصاصی",
     minval = 1, maxval = 95, step = 1, group = gRisk)
longLev = input.float(1.0, "اهرم لانگ", minval = 1, maxval = 10,
     step = 1, group = gRisk)
shortLev = input.float(1.0, "اهرم شورت", minval = 1, maxval = 10,
     step = 1, group = gRisk)
tpPct = input.float(0.30, "حد سود قیمتی (%)",
     minval = 0.01, maxval = 30, step = 0.05, group = gRisk)
slPct = input.float(0.60, "حد ضرر قیمتی (%)",
     minval = 0.01, maxval = 30, step = 0.05, group = gRisk)

// ─────────────────────────────────────────────────────────────────────
// 4. Confirmed daily and weekly directions — NO lookahead / repaint
// ─────────────────────────────────────────────────────────────────────
// Definition of direction: the last FINISHED daily/weekly close
// compared against the close of the period immediately before it.
// A bullish DAILY and bullish WEEKLY period allows Long; two bearish
// periods allow Short. Equal/contradictory readings block both sides.
[dClose, dPrev] = request.security(syminfo.tickerid, "D",
     [close[1], close[2]], lookahead = barmerge.lookahead_on)
[wClose, wPrev] = request.security(syminfo.tickerid, "W",
     [close[1], close[2]], lookahead = barmerge.lookahead_on)
dailyBull = not na(dClose) and not na(dPrev) and dClose > dPrev
dailyBear = not na(dClose) and not na(dPrev) and dClose < dPrev
weeklyBull = not na(wClose) and not na(wPrev) and wClose > wPrev
weeklyBear = not na(wClose) and not na(wPrev) and wClose < wPrev
longAllowed = allowLong and dailyBull and weeklyBull
shortAllowed = allowShort and dailyBear and weeklyBear

// ─────────────────────────────────────────────────────────────────────
// 5. Rolling HIGH and LOW from previous closed 1m candles:
//    3h=180, 6h=360, 9h=540, 12h=720, 24h=1440, 48h=2880.
//    [1] ensures the signal candle cannot define its own entry level.
// ─────────────────────────────────────────────────────────────────────
float h3 = ta.highest(high[1], 180)
float l3 = ta.lowest(low[1], 180)
float h6 = ta.highest(high[1], 360)
float l6 = ta.lowest(low[1], 360)
float h9 = ta.highest(high[1], 540)
float l9 = ta.lowest(low[1], 540)
float h12 = ta.highest(high[1], 720)
float l12 = ta.lowest(low[1], 720)
float h24 = ta.highest(high[1], 1440)
float l24 = ta.lowest(low[1], 1440)
float h48 = ta.highest(high[1], 2880)
float l48 = ta.lowest(low[1], 2880)

// A complete 24/7 history for each enabled window must be available.
// A missing minute or a chart-session gap invalidates that window.
ready3 = not na(time[180]) and time - time[180] == 180 * 60000 and
     not na(h3) and not na(l3)
ready6 = not na(time[360]) and time - time[360] == 360 * 60000 and
     not na(h6) and not na(l6)
ready9 = not na(time[540]) and time - time[540] == 540 * 60000 and
     not na(h9) and not na(l9)
ready12 = not na(time[720]) and time - time[720] == 720 * 60000 and
     not na(h12) and not na(l12)
ready24 = not na(time[1440]) and time - time[1440] == 1440 * 60000 and
     not na(h24) and not na(l24)
ready48 = not na(time[2880]) and time - time[2880] == 2880 * 60000 and
     not na(h48) and not na(l48)

// Near ANY selected high OR low qualifies. Trade direction comes
// solely from confirmed D+W alignment, not from which line was hit.
f_near(float level) =>
    not na(level) and level > 0 and
     100 * math.abs(close - level) / level <= tolerancePct
hit3 = use3h and ready3 and (f_near(h3) or f_near(l3))
hit6 = use6h and ready6 and (f_near(h6) or f_near(l6))
hit9 = use9h and ready9 and (f_near(h9) or f_near(l9))
hit12 = use12h and ready12 and (f_near(h12) or f_near(l12))
hit24 = use24h and ready24 and (f_near(h24) or f_near(l24))
hit48 = use48h and ready48 and (f_near(h48) or f_near(l48))
hitAnyLevel = hit3 or hit6 or hit9 or hit12 or hit24 or hit48
lineEntryOK = not requireLineClose or hitAnyLevel

// ─────────────────────────────────────────────────────────────────────
// 6. M1 order sizing. No position if resulting size < mincontract.
// ─────────────────────────────────────────────────────────────────────
is1m = timeframe.isminutes and timeframe.multiplier == 1
validQuote = syminfo.currency == "USD" or syminfo.currency == "USDT"
float quoteEquity = nz(strategy.convert_to_symbol(math.max(strategy.equity, 0)),
     math.max(strategy.equity, 0))
float orderCollateral = quoteEquity * capitalPct / 100.0
float unitNotional = close * syminfo.pointvalue
float lotStep = syminfo.mincontract
float longQty = unitNotional > 0 and lotStep > 0 ?
     math.floor(orderCollateral * longLev / unitNotional / lotStep) * lotStep : na
float shortQty = unitNotional > 0 and lotStep > 0 ?
     math.floor(orderCollateral * shortLev / unitNotional / lotStep) * lotStep : na

var int lastEntryBar = na
cooldownOK = na(lastEntryBar) or bar_index - lastEntryBar >= entryCooldown
canEnter = is1m and validQuote and barstate.isconfirmed and
     strategy.position_size == 0 and strategy.equity > 0 and cooldownOK
enterLong = canEnter and longAllowed and lineEntryOK and
     not na(longQty) and longQty >= lotStep
enterShort = canEnter and shortAllowed and lineEntryOK and
     not na(shortQty) and shortQty >= lotStep

// TP/SL orders use ticks relative to the emulated entry fill price.
// On subsequent bars the exits are updated from the actual average fill.
int tpTicks = math.max(1, int(math.round(close * tpPct / 100 / syminfo.mintick)))
int slTicks = math.max(1, int(math.round(close * slPct / 100 / syminfo.mintick)))
string baseAlert = '"strategy":"BTC-levels-1m","version":"1.1","symbol":"' +
     syminfo.tickerid + '","timeframe":"1"'

if enterLong
    lastEntryBar := bar_index
    strategy.entry("L", strategy.long, qty = longQty,
         alert_message = '{' + baseAlert + ',"event":"entry","side":"long"}')
    strategy.exit("L-TP-SL", from_entry = "L", profit = tpTicks, loss = slTicks,
         alert_message = '{' + baseAlert + ',"event":"exit","side":"long"}')

if enterShort
    lastEntryBar := bar_index
    strategy.entry("S", strategy.short, qty = shortQty,
         alert_message = '{' + baseAlert + ',"event":"entry","side":"short"}')
    strategy.exit("S-TP-SL", from_entry = "S", profit = tpTicks, loss = slTicks,
         alert_message = '{' + baseAlert + ',"event":"exit","side":"short"}')

float activeTP = na
float activeSL = na
if strategy.position_size > 0
    activeTP := math.round_to_mintick(strategy.position_avg_price * (1 + tpPct / 100))
    activeSL := math.round_to_mintick(strategy.position_avg_price * (1 - slPct / 100))
    strategy.exit("L-TP-SL", from_entry = "L", limit = activeTP, stop = activeSL,
         alert_message = '{' + baseAlert + ',"event":"exit","side":"long"}')
if strategy.position_size < 0
    activeTP := math.round_to_mintick(strategy.position_avg_price * (1 - tpPct / 100))
    activeSL := math.round_to_mintick(strategy.position_avg_price * (1 + slPct / 100))
    strategy.exit("S-TP-SL", from_entry = "S", limit = activeTP, stop = activeSL,
         alert_message = '{' + baseAlert + ',"event":"exit","side":"short"}')

// ─────────────────────────────────────────────────────────────────────
// 7. All twelve lines are independently visible by window. Plotting
//    does NOT change which line windows are allowed for entry.
// ─────────────────────────────────────────────────────────────────────
gView = "۴. خطوط و نمایش"
show3h = input.bool(true, "نمایش خطوط ۳ ساعت", group = gView)
show6h = input.bool(true, "نمایش خطوط ۶ ساعت", group = gView)
show9h = input.bool(true, "نمایش خطوط ۹ ساعت", group = gView)
show12h = input.bool(true, "نمایش خطوط ۱۲ ساعت", group = gView)
show24h = input.bool(true, "نمایش خطوط ۲۴ ساعت", group = gView)
show48h = input.bool(true, "نمایش خطوط ۴۸ ساعت", group = gView)
showTriangle = input.bool(true, "نمایش مثلث کمرنگ ۴۸ به ۲۴ ساعت",
     tooltip = "قاعده: سقف و کف ۴۸ ساعت گذشته در مرز ۲۴ ساعت قبل؛ رأس: وسط سقف و کف ۲۴ ساعت در کندل آخر. صرفاً نمایشی.",
     group = gView)
triangleOpacity = input.int(90, "شفافیت داخل مثلث (%)",
     minval = 70, maxval = 99, step = 1,
     tooltip = "عدد بیشتر یعنی مثلث کمرنگ‌تر. تأثیری بر سیگنال‌ها ندارد.",
     group = gView)
showDash = input.bool(true, "نمایش داشبورد", group = gView)

plot(show3h and is1m and ready3 ? h3 : na, "سقف ۳ ساعت",
     color = color.fuchsia, linewidth = 2, style = plot.style_stepline)
plot(show3h and is1m and ready3 ? l3 : na, "کف ۳ ساعت",
     color = color.fuchsia, linewidth = 2, style = plot.style_stepline)
plot(show6h and is1m and ready6 ? h6 : na, "سقف ۶ ساعت",
     color = color.blue, linewidth = 2, style = plot.style_stepline)
plot(show6h and is1m and ready6 ? l6 : na, "کف ۶ ساعت",
     color = color.blue, linewidth = 2, style = plot.style_stepline)
plot(show9h and is1m and ready9 ? h9 : na, "سقف ۹ ساعت",
     color = color.lime, linewidth = 2, style = plot.style_stepline)
plot(show9h and is1m and ready9 ? l9 : na, "کف ۹ ساعت",
     color = color.lime, linewidth = 2, style = plot.style_stepline)
plot(show12h and is1m and ready12 ? h12 : na, "سقف ۱۲ ساعت",
     color = color.orange, linewidth = 2, style = plot.style_stepline)
plot(show12h and is1m and ready12 ? l12 : na, "کف ۱۲ ساعت",
     color = color.orange, linewidth = 2, style = plot.style_stepline)
plot(show24h and is1m and ready24 ? h24 : na, "سقف ۲۴ ساعت",
     color = color.aqua, linewidth = 2, style = plot.style_stepline)
plot(show24h and is1m and ready24 ? l24 : na, "کف ۲۴ ساعت",
     color = color.aqua, linewidth = 2, style = plot.style_stepline)
plot(show48h and is1m and ready48 ? h48 : na, "سقف ۴۸ ساعت",
     color = color.yellow, linewidth = 2, style = plot.style_stepline)
plot(show48h and is1m and ready48 ? l48 : na, "کف ۴۸ ساعت",
     color = color.yellow, linewidth = 2, style = plot.style_stepline)
plot(activeTP, "حد سود فعال", color = color.green, style = plot.style_linebr)
plot(activeSL, "حد ضرر فعال", color = color.red, style = plot.style_linebr)
// ─────────────────────────────────────────────────────────────────────
// 8. VISUAL-ONLY live triangular range envelope (latest 48h → 24h).
//    Base: latest rolling 48h high/low, placed at x = now - 24h.
//    Apex: midpoint of latest rolling 24h high/low, placed at now.
//    The base location is SCHEMATIC, not the historical value 24h ago.
//    Reuse line IDs and one linefill; NEVER alter signals or positions.
// ─────────────────────────────────────────────────────────────────────
var line funnelTop = na
var line funnelBottom = na
var line funnelBase = na
var linefill funnelFill = na
bool funnelReady = showTriangle and is1m and ready48 and ready24 and
     not na(h48) and not na(l48) and not na(h24) and not na(l24) and
     h48 > l48 and h24 >= l24
if barstate.islast
    if funnelReady
        int leftBar = bar_index - 1440
        int rightBar = bar_index
        float apex = (h24 + l24) / 2.0
        color edgeCol = color.new(color.yellow, math.max(55, triangleOpacity - 18))
        color fillCol = color.new(color.yellow, triangleOpacity)
        if na(funnelTop)
            funnelTop := line.new(leftBar, h48, rightBar, apex,
                 xloc = xloc.bar_index, extend = extend.none,
                 color = edgeCol, width = 1)
            funnelBottom := line.new(leftBar, l48, rightBar, apex,
                 xloc = xloc.bar_index, extend = extend.none,
                 color = edgeCol, width = 1)
            funnelBase := line.new(leftBar, h48, leftBar, l48,
                 xloc = xloc.bar_index, extend = extend.none,
                 color = edgeCol, width = 1)
            funnelFill := linefill.new(funnelTop, funnelBottom, fillCol)
        else
            line.set_xy1(funnelTop, leftBar, h48)
            line.set_xy2(funnelTop, rightBar, apex)
            line.set_xy1(funnelBottom, leftBar, l48)
            line.set_xy2(funnelBottom, rightBar, apex)
            line.set_xy1(funnelBase, leftBar, h48)
            line.set_xy2(funnelBase, leftBar, l48)
            line.set_color(funnelTop, edgeCol)
            line.set_color(funnelBottom, edgeCol)
            line.set_color(funnelBase, edgeCol)
            linefill.set_color(funnelFill, fillCol)
    else
        if not na(funnelTop)
            line.delete(funnelTop)
            line.delete(funnelBottom)
            line.delete(funnelBase)
            funnelTop := na
            funnelBottom := na
            funnelBase := na
            funnelFill := na

plotshape(enterLong, title = "ورود لانگ", style = shape.triangleup,
     location = location.belowbar, color = color.green, size = size.tiny)
plotshape(enterShort, title = "ورود شورت", style = shape.triangledown,
     location = location.abovebar, color = color.red, size = size.tiny)

var table dashboard = table.new(position.top_right, 2, 7, border_width = 1)
string dText = dailyBull ? "صعودی" : dailyBear ? "نزولی" : "خنثی"
string wText = weeklyBull ? "صعودی" : weeklyBear ? "نزولی" : "خنثی"
string modeText = not is1m ? "چارت ۱ دقیقه لازم" :
     not validQuote ? "نماد نامعتبر" :
     longAllowed ? "لانگ" : shortAllowed ? "شورت" : "توقف معامله"
string lineText = not requireLineClose ? "شرط خاموش" :
     not (use3h or use6h or use9h or use12h or use24h or use48h) ? "هیچ بازه فعال نیست" :
     hitAnyLevel ? "کلوز نزدیک سطح" : "کلوز دور از سطح"
string posText = strategy.position_size > 0 ? "لانگ باز" :
     strategy.position_size < 0 ? "شورت باز" : "بدون پوزیشن"
string qtyText = longAllowed ? str.tostring(longQty) :
     shortAllowed ? str.tostring(shortQty) : "—"
if barstate.islast
    if showDash
        table.cell(dashboard, 0, 0, "روند روزانه", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 0, dText, bgcolor = dailyBull ? color.green : dailyBear ? color.red : color.gray, text_color = color.white)
        table.cell(dashboard, 0, 1, "روند هفتگی", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 1, wText, bgcolor = weeklyBull ? color.green : weeklyBear ? color.red : color.gray, text_color = color.white)
        table.cell(dashboard, 0, 2, "جهت مجاز", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 2, modeText, bgcolor = color.gray, text_color = color.white)
        table.cell(dashboard, 0, 3, "شرط خطوط", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 3, lineText, bgcolor = lineEntryOK ? color.green : color.gray, text_color = color.white)
        table.cell(dashboard, 0, 4, "پوزیشن", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 4, posText, bgcolor = color.gray, text_color = color.white)
        table.cell(dashboard, 0, 5, "حجم سفارش", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 5, qtyText, bgcolor = color.gray, text_color = color.white)
        table.cell(dashboard, 0, 6, "TP / SL", bgcolor = color.black, text_color = color.white)
        table.cell(dashboard, 1, 6, str.tostring(tpPct) + "% / " + str.tostring(slPct) + "%",
             bgcolor = color.black, text_color = color.white)
    else
        table.clear(dashboard, 0, 0, 1, 6)
